# Copy this file to .env and fill in your values.
#
# Primary (SRV — needs working DNS for _mongodb._tcp lookups):
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/smart_lgu?retryWrites=true&w=majority
#
# Optional fallback if you get: querySrv ECONNREFUSED / _mongodb._tcp
# Use a STANDARD (non-SRV) URI: starts with mongodb:// and lists :27017 hosts.
# Get it from Atlas → Connect → Compass (copy string), or Atlas docs "connection string standard".
# Same username/password; include ?ssl=true&replicaSet=...&authSource=admin as Atlas shows.
# MONGODB_URI_STANDARD=mongodb://USERNAME:PASSWORD@host1:27017,host2:27017,host3:27017/smart_lgu?ssl=true&replicaSet=atlas-xxxxx&authSource=admin
#
PORT=3000
CORS_ORIGIN=http://localhost:5173

# OpenAI (required for RAG chat + ingest)
OPENAI_API_KEY=

# RAG / MongoDB vector store (defaults match atlas-vector-index-definition.json)
# RAG_DB_NAME=knowledge_chunks
# RAG_COLLECTION=chunks
# Must match the Atlas Vector Search index name exactly (often "default")
# VECTOR_INDEX_NAME=default
